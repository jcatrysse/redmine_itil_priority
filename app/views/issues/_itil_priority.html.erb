<% settings = RedmineItilPriority.settings_for(@project, @issue.tracker) %>
<% if settings %>
<% can_override = @issue.safe_attribute?('priority_id') && @issue.safe_attribute?('itil_priority_linked') %>
<% linked = @issue.itil_priority_active? %>
<% help = %w[urgency impact].to_h { |field| [field, RedmineItilPriority.help_texts(settings, field)] } %>
<style>
  .itil-priority { position:relative; display:inline-block; min-width:470px; min-height:50px;
                   background-color:#fffff3; padding:4px 6px; border:1px solid #eee; }
  .itil-priority label.inline { font-weight:normal; display:inline-block; width:90px; text-align:left; white-space:nowrap; }
  .itil-priority select { width:150px !important; }
  .itil-priority .itil-value { display:inline-block; width:150px; }
  .real-priority { box-sizing:border-box; width:100%; position:absolute; top:0; left:260px; height:100%; padding-top:1.4em; }
  .real-priority > .priority { position:absolute; top:1.4em; left:25px; font-size:110%; }
  #itil_priority_link.unlink { opacity:0.4; }
  #itil_priority_link .itil-unlinked, #itil_priority_link.unlink .itil-linked { display:none; }
  #itil_priority_link.unlink .itil-unlinked { display:inline; }
  #itil_priority_link.readonly { cursor:default; }
  .itil-priority .itil-help-toggle { margin-left:2px; }
  .itil-help, .itil-help-current > div { margin:0 0 6px 180px; padding:4px 8px; max-width:600px; background-color:#fffff3; border:1px solid #eee; }
  .itil-help-current > div { color:#555; }
  .itil-help-current p, .itil-help-level p { margin:2px 0; }
  .itil-help-level { padding:2px 4px; }
  .itil-help-level.selected { background-color:#ffe9a8; }
</style>
<% (1..3).each do |i| %>
  <% (1..3).each do |u| %>
    <% key = "priority_i#{i}_u#{u}" %>
    <%= content_tag(:span, settings[key], id: key, style: 'display:none;') %>
  <% end %>
<% end %>
<p id="itil_priority_field" data-new-record="<%= @issue.new_record? %>" data-default-priority="<%= IssuePriority.default.try(:id) %>" data-current-priority="<%= @issue.priority_id %>"
   data-can-override="<%= can_override %>" data-linked="<%= linked %>"
   data-title-linked="<%= l(:label_itil_priority_linked) %>" data-title-unlinked="<%= l(:label_itil_priority_unlinked) %>">
<label><%= l(:field_priority) %></label>
<span class=itil-priority>
  <% [['urgency', RedmineItilPriority.urgency_options(@project, @issue.tracker)],
      ['impact', RedmineItilPriority.impact_options(@project, @issue.tracker)]].each_with_index do |(field, options), index| %>
    <%= tag.br if index > 0 %>
    <label class=inline><%= l(:"field_#{field}") %><%= content_tag(:span, ' *', class: 'required') if @issue.required_attribute?("#{field}_id") %><% if help[field].any? %>
      <%= link_to sprite_icon('help'), '#', class: 'itil-help-toggle icon-only', title: l(:label_itil_help), data: { target: "itil_help_#{field}" } %><% end %></label>
    <% value = @issue.send("#{field}_id") %>
    <% if @issue.safe_attribute?("#{field}_id") %>
      <%= select_tag "issue[#{field}_id]", options_for_select([["", ""]] + options, value) %>
    <% else %>
      <%= content_tag :span, options.detect { |o| o[1] == value.to_s }&.first, id: "issue_#{field}_id", class: 'itil-value', data: { value: value.to_s } %>
    <% end %>
  <% end %>
  <%= hidden_field_tag 'issue[itil_priority_linked]', linked ? '1' : '0', id: 'itil_priority_linked' if can_override %>
  <span class=real-priority>
    <% link_options = { id: "itil_priority_link",
                        class: [('unlink' unless linked), ('readonly' unless can_override)].compact.join(' '),
                        title: l(linked ? :label_itil_priority_linked : :label_itil_priority_unlinked),
                        style: (can_override ? 'cursor:pointer;' : nil) } %>
    <% if respond_to?(:sprite_icon) %>
      <%= content_tag :span, sprite_icon('link', css_class: 'itil-linked') + sprite_icon('link-break', css_class: 'itil-unlinked'),
                      link_options.merge(class: "#{link_options[:class]} icon-only") %>
    <% else %>
      <%= image_tag("stock_link.png", link_options.merge(plugin: "redmine_itil_priority")) %>
    <% end %>
    <span class=priority>
      <% if can_override %>
      <%= select_tag "issue[priority_id]", options_for_select(@priorities.map { |p| [p.name, p.id] }, @issue.priority_id),
                     id: 'itil_issue_priority_id', disabled: !@issue.leaf?, style: 'display:none;' %>
      <% end %>
      <%= content_tag :span, @issue.priority, id: "real-priority-display" %>
    </span>
  </span>
  </span>
</p>
<div id="itil_priority_help">
<% help.each do |field, texts| %>
  <% next if texts.empty? %>
  <% labels = RedmineItilPriority.options_for(field, @project, @issue.tracker).to_h { |label, level| [level, label] } %>
  <div id="itil_help_current_<%= field %>" class="itil-help-current">
    <% texts.each do |level, text| %>
    <div class="wiki" data-level="<%= level %>" style="display:none;"><strong><%= labels[level.to_s] %></strong><%= textilizable text, project: @project %></div>
    <% end %>
  </div>
  <div id="itil_help_<%= field %>" class="itil-help" style="display:none;">
    <strong><%= l(:"field_itil_help_#{field}") %></strong>
    <% (1..3).each do |level| %>
    <div class="itil-help-level wiki" data-level="<%= level %>"><strong><%= labels[level.to_s] %></strong><%= textilizable(texts[level], project: @project) if texts[level] %></div>
    <% end %>
  </div>
<% end %>
</div>
<script>
$(function() {
  var $field = $("#itil_priority_field")
  var canOverride = $field.data('can-override') === true
  var $priority = $("#issue_priority_id").closest('p')
  if ($priority.length) {
    $priority.replaceWith($field)
  } else if ($("#issue_status_id").closest('p').length) {
    // without the permission core shows no priority field: take its place after the status
    $("#issue_status_id").closest('p').after($field)
  }
  $field.after($("#itil_priority_help"))
  $field.find('.itil-help-toggle').on('click', function(e) {
    e.preventDefault()
    $('#' + $(this).data('target')).toggle()
  })
  var $select = $("#itil_issue_priority_id")
  var $link = $("#itil_priority_link")
  var linked = canOverride ? $('#itil_priority_linked').val() !== '0' : $field.data('linked') === true
  var defaultPriority = String($field.data('default-priority'))
  var currentPriority = String($field.data('current-priority'))
  var priorityNames = <%= raw json_escape(IssuePriority.active.map { |p| [p.id.to_s, p.name] }.to_h.to_json) %>

  function itilValue(name) {
    var $el = $("#issue_" + name + "_id")
    return $el.is('select') ? $el.val() : String($el.data('value') || '')
  }

  function showPriority(priority_id) {
    if (canOverride) {
      $select.val(priority_id)
      $("#real-priority-display").text($select.find("option:selected").text())
    } else {
      $("#real-priority-display").text(priorityNames[priority_id] || '')
    }
  }

  // the explanation of the chosen level under the field, and marked in the overview
  function showHelp() {
    ['urgency', 'impact'].forEach(function(name) {
      var level = itilValue(name)
      $('#itil_help_current_' + name + ' > div').hide().filter('[data-level="' + level + '"]').show()
      $('#itil_help_' + name + ' .itil-help-level').removeClass('selected').filter('[data-level="' + level + '"]').addClass('selected')
    })
  }

  function recalculateItilPriority(impact, urgency) {
    showPriority($("#priority_i" + impact + "_u" + urgency).text())
  }

  function setLinked(state) {
    linked = state
    $('#itil_priority_linked').val(linked ? '1' : '0')
    $link.toggleClass('unlink', !linked)
    $link.attr('title', $field.data(linked ? 'title-linked' : 'title-unlinked'))
    if (linked) {
      $select.hide()
      $('#real-priority-display').show()
      syncPriority()
    } else {
      $select.show()
      $('#real-priority-display').hide()
    }
  }

  function syncPriority() {
    var impact = itilValue('impact')
    var urgency = itilValue('urgency')
    if (linked) {
      if (impact === '' || urgency === '') {
        // without both, a new issue gets the default priority, an existing one keeps its own
        showPriority($field.data('new-record') ? defaultPriority : currentPriority)
      } else {
        recalculateItilPriority(impact, urgency)
      }
    }
  }

  $("select#issue_urgency_id, select#issue_impact_id").on("change", syncPriority).on("change", showHelp)

  if (canOverride) {
    $link.on('click', function() {
      setLinked(!linked)
    })
    if (!linked) { setLinked(false) }
  }
  var isNew = $field.data('new-record')
  if (isNew && itilValue('impact') === '' && itilValue('urgency') === '' &&
      $("select#issue_impact_id").length && $("select#issue_urgency_id").length) {
    outer:
    for (var i = 1; i <= 3; i++) {
      for (var u = 1; u <= 3; u++) {
        var span = $("#priority_i" + i + "_u" + u)
        if (span.text() === defaultPriority) {
          $("#issue_impact_id").val(i)
          $("#issue_urgency_id").val(u)
          if (canOverride) { setLinked(true) }
          break outer
        }
      }
    }
  }

  syncPriority()
  showHelp()
})
</script>
<% end %>
